SMT_MASTER_KEY=
SMT_ADMIN_EMAIL=
# at least 10 characters (a shorter one is refused and the admin is not created)
SMT_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
SMT_TZ=Europe/Rome
# LAN IPs / host names of this PC, comma separated: the web app answers only these (plus
# localhost) and its https certificate covers them. Default 192.168.30.7.
SMT_PUBLIC_HOSTS=192.168.30.7
